
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ECHOX — Music Search</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080808;color:#f5f5f5;
font-family:Arial,sans-serif;min-height:100vh}
header{text-align:center;padding:35px 15px 20px}
.logo{font-size:38px;font-weight:900;letter-spacing:9px}
.sub{color:#888;font-size:12px;letter-spacing:3px;margin-top:8px}
main{width:92%;max-width:680px;margin:20px auto}
form{display:flex;gap:8px}
input{flex:1;min-width:0;background:#171717;border:1px solid #333;
border-radius:12px;padding:15px;color:white;font-size:16px;outline:none}
input:focus{border-color:#aaa}
button{background:#f2f2f2;color:#111;border:0;border-radius:12px;
padding:0 18px;font-size:15px;font-weight:bold;cursor:pointer}
#status{color:#aaa;font-size:13px;margin:20px 2px}
.track{display:flex;align-items:center;gap:12px;
padding:12px 0;border-bottom:1px solid #242424}
.cover{width:58px;height:58px;border-radius:8px;object-fit:cover;
background:#222;flex-shrink:0}
.info{flex:1;min-width:0}
.name{font-weight:bold;font-size:15px;overflow-wrap:anywhere}
.artist{font-size:13px;color:#999;margin-top:6px}
.play{width:44px;height:44px;padding:0;border-radius:50%;flex-shrink:0}
audio{width:100%;margin-top:20px}
footer{text-align:center;color:#555;font-size:11px;padding:30px 10px}
a{color:#bbb;font-size:12px}
</style>
</head>
<body>
<header>
  <div class="logo">ECHOX</div>
  <div class="sub">FIND YOUR SOUND</div>
</header>

<main>
  <form id="form">
    <input id="query" placeholder="Qo‘shiq yoki ijrochi nomi..."
    autocomplete="off" required>
    <button type="submit">Qidirish</button>
  </form>

  <div id="status">Qo‘shiq nomini yozib qidiring.</div>
  <div id="results"></div>
  <p id="now"></p>
  <audio id="player" controls></audio>
  <p><a href="https://www.apple.com/legal/internet-services/itunes/"
  target="_blank" rel="noopener">Manba: Apple iTunes</a></p>
</main>

<footer>ECHOX · MUSIC DISCOVERY</footer>

<script>
const results = document.getElementById("results");
const status = document.getElementById("status");
const player = document.getElementById("player");
const now = document.getElementById("now");
let requestNumber = 0;

function searchCountry(query, country, id, fallback) {
  status.textContent = "Qidirilmoqda...";
  const callback = "echoxCallback" + id;
  const params = new URLSearchParams({
    term: query,
    entity: "song",
    limit: "25",
    country: country,
    callback: callback
  });

  const script = document.createElement("script");
  script.src = "https://itunes.apple.com/search?" + params.toString();

  function cleanup() {
    try { delete window[callback]; } catch(e) {}
    script.remove();
  }

  window[callback] = function(data) {
    cleanup();
    if (id !== requestNumber) return;

    const tracks = data && data.results ? data.results : [];

    if (!tracks.length && fallback) {
      searchCountry(query, "US", id, false);
      return;
    }

    if (!tracks.length) {
      status.textContent =
        "Qo‘shiq topilmadi. Boshqa nom yoki ijrochini yozing.";
      return;
    }

    status.textContent = tracks.length + " ta natija topildi.";
    showTracks(tracks);
  };

  script.onerror = function() {
    cleanup();
    if (id === requestNumber) {
      status.textContent =
        "Internet yoki qidiruv xizmatida xatolik yuz berdi.";
    }
  };

  document.body.appendChild(script);
}

function showTracks(tracks) {
  results.replaceChildren();

  tracks.forEach(track => {
    const row = document.createElement("div");
    row.className = "track";

    const cover = document.createElement("img");
    cover.className = "cover";
    cover.alt = "Albom rasmi";
    cover.src = track.artworkUrl100 || "";

    const info = document.createElement("div");
    info.className = "info";

    const name = document.createElement("div");
    name.className = "name";
    name.textContent = track.trackName || "Nomsiz qo‘shiq";

    const artist = document.createElement("div");
    artist.className = "artist";
    artist.textContent = track.artistName || "Noma’lum ijrochi";

    info.append(name, artist);

    const play = document.createElement("button");
    play.className = "play";
    play.textContent = "▶";
    play.setAttribute("aria-label", "Tinglash");

    play.onclick = function() {
      if (!track.previewUrl) {
        status.textContent =
          "Bu qo‘shiq uchun tinglash namunasi mavjud emas.";
        return;
      }
      player.src = track.previewUrl;
      now.textContent = "Ijro: " + track.trackName;
      player.play().catch(() => {
        status.textContent =
          "Ijro boshlanmadi. ▶ tugmasini yana bosing.";
      });
    };

    row.append(cover, info, play);
    results.appendChild(row);
  });
}

document.getElementById("form").addEventListener("submit", function(e) {
  e.preventDefault();
  const query = document.getElementById("query").value.trim();
  if (!query) return;

  const id = ++requestNumber;
  results.replaceChildren();
  now.textContent = "";
  player.pause();
  player.removeAttribute("src");
  player.load();

  searchCountry(query, "UZ", id, true);
});
</script>
</body>
</html>
