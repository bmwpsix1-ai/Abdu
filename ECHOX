
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ECHOX Music</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0; padding: 25px 18px;
  background: #0b0b0f; color: #f4f4f7;
  font-family: Arial, sans-serif;
}
header { text-align: center; margin: 50px 0 40px; }
.logo { font-size: 34px; letter-spacing: 9px; font-weight: bold; }
.logo span { color: #9b8cff; }
p { color: #9999aa; line-height: 1.6; }
header p { font-size: 14px; }
main { max-width: 500px; margin: auto; }
.search {
  display: flex; gap: 8px;
  background: #191920; padding: 8px;
  border: 1px solid #343440; border-radius: 14px;
}
input {
  width: 100%; min-width: 0; padding: 12px 8px;
  color: white; background: transparent;
  border: 0; outline: none; font-size: 15px;
}
button {
  border: 0; border-radius: 10px; padding: 12px;
  background: #9b8cff; color: #11111a;
  font-weight: bold; cursor: pointer;
}
.search button { white-space: nowrap; }
h2 { margin-top: 35px; font-size: 18px; }
#results { margin-top: 18px; }
.song {
  padding: 16px 12px; margin: 10px 0;
  border: 1px solid #292933; border-radius: 12px;
  background: #14141a;
}
.song b { display: block; margin-bottom: 7px; }
.song small { color: #aaaabb; }
#status { margin-top: 16px; font-size: 14px; }
footer { text-align: center; margin-top: 55px; font-size: 12px; }
</style>
</head>
<body>
<header>
  <div class="logo">ECHO<span>X</span></div>
  <p>Har bir ovozning o‘z izi bor.</p>
</header>

<main>
  <p>Qo‘shiq yoki ijrochi nomini kiriting.</p>
  <div class="search">
    <input id="q" placeholder="Masalan, Faded..." />
    <button onclick="searchSongs()">Izlash</button>
  </div>

  <p style="text-align:center">— yoki —</p>
  <button style="width:100%" onclick="listen()">🎙 Ovoz bilan izlash</button>
  <div id="status"></div>

  <h2>Qidiruv natijalari</h2>
  <div id="results">
    <p>Qo‘shiq qidirishni boshlang.</p>
  </div>
</main>

<footer>ECHOX · Musiqani toping.</footer>

<script>
const songs = [
  {name:"Faded", artist:"Alan Walker"},
  {name:"Blinding Lights", artist:"The Weeknd"},
  {name:"Mockingbird", artist:"Eminem"},
  {name:"Lovely", artist:"Billie Eilish, Khalid"},
  {name:"Yurak", artist:"Konsta"},
  {name:"Dusk Till Dawn", artist:"ZAYN, Sia"}
];

function searchSongs() {
  const q = document.getElementById("q").value
    .trim().toLocaleLowerCase();

  const found = songs.filter(s =>
    (s.name + " " + s.artist)
      .toLocaleLowerCase().includes(q)
  );

  document.getElementById("results").innerHTML =
    found.length
      ? found.map(s =>
          `<div class="song"><b>${s.name}</b>
           <small>${s.artist}</small></div>`
        ).join("")
      : "<p>Natija topilmadi. Boshqa nom bilan izlang.</p>";
}

function listen() {
  const Speech = window.SpeechRecognition ||
                 window.webkitSpeechRecognition;

  if (!Speech) {
    document.getElementById("status").textContent =
      "Ovozli qidiruv bu brauzerda ishlamayapti. Chrome orqali urinib ko‘ring.";
    return;
  }

  const rec = new Speech();
  rec.lang = "uz-UZ";
  rec.onstart = () => {
    document.getElementById("status").textContent =
      "Tinglayapman... Qo‘shiq nomini ayting.";
  };
  rec.onresult = e => {
    document.getElementById("q").value =
      e.results[0][0].transcript;
    document.getElementById("status").textContent =
      "Eshitilgan so‘z bo‘yicha qidirildi.";
    searchSongs();
  };
  rec.onerror = () => {
    document.getElementById("status").textContent =
      "Ovoz aniqlanmadi. Mikrofon ruxsatini tekshiring.";
  };
  rec.start();
}
</script>
</body>
</html>
